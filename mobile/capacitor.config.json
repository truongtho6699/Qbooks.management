{
  "appId": "vn.qbooks.quantri",
  "appName": "QBooks",
  "webDir": "www",
  "server": {
    "url": "https://qbooks-quantri.pages.dev",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "appendUserAgent": "QBooksApp/1.0",
  "backgroundColor": "#f5f8fd",
  "android": { "allowMixedContent": false },
  "ios": { "contentInset": "never", "limitsNavigationsToAppBoundDomains": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 600, "backgroundColor": "#2563eb", "showSpinner": false },
    "StatusBar": { "overlaysWebView": false, "style": "LIGHT", "backgroundColor": "#2563eb" }
  }
}
